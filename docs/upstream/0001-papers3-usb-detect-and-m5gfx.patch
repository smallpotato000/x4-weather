+constexpr int HIGH = 1, LOW = 0, INPUT = 1, OUTPUT = 3, INPUT_PULLUP = 5, INPUT_PULLDOWN = 9;
 inline unsigned long hostMillis = 0;  // the test's clock; delay() advances it
 inline unsigned long millis() { return hostMillis; }
